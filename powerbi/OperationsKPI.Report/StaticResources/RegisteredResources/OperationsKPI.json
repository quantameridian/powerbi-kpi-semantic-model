{
  "name": "OperationsKPI.json",
  "dataColors": [
    "#245C7A",
    "#3D7A4D",
    "#C4932F",
    "#A64242",
    "#6B5FA8",
    "#4F6F68",
    "#7B5C3E"
  ],
  "background": "#F7F8FA",
  "foreground": "#17212B",
  "tableAccent": "#245C7A",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#17212B"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 11,
      "color": "#34424F"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#17212B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D6DCE2"
              }
            },
            "radius": 4
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit"
          }
        ]
      }
    }
  }
}
