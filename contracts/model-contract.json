{
  "status": "source_controlled_pbip",
  "description": "Machine readable contract for the Operations KPI PBIP project, TMDL semantic model, PBIR report and synthetic source data.",
  "project": {
    "pbip": "powerbi/OperationsKPI.pbip",
    "semantic_model": "powerbi/OperationsKPI.SemanticModel",
    "report": "powerbi/OperationsKPI.Report",
    "as_at_date": "2026-06-30"
  },
  "source_files": {
    "data/sample-operational-data.csv": {
      "row_count": 32,
      "columns": ["item_id", "item_reference", "opened_date", "due_date", "closed_date", "reporting_period", "service_area_id", "owner_id", "category_id", "status", "priority", "target_key", "evidence_status", "closure_evidence_link", "review_flag", "notes"]
    },
    "data/sample-targets.csv": {
      "row_count": 16,
      "columns": ["target_key", "target_id", "category_id", "priority", "target_days", "target_met_rate", "effective_from", "effective_to", "target_owner_role", "notes"]
    },
    "data/sample-reference-data.csv": {
      "row_count": 27,
      "columns": ["reference_type", "reference_id", "reference_name", "parent_reference_id", "active_flag", "sort_order", "notes"]
    },
    "data/sample-security-access.csv": {
      "row_count": 6,
      "columns": ["user_principal_name", "service_area_id", "access_role", "active_flag"]
    }
  },
  "tables": {
    "Operational Item": {"kind": "fact", "grain": "One row per operational work item", "source": "OperationalSource"},
    "Target": {"kind": "dimension", "grain": "One row per category and priority target", "source": "TargetSource"},
    "Date": {"kind": "dimension", "grain": "One row per calendar date", "source": "Generated Power Query calendar"},
    "Service Area": {"kind": "dimension", "grain": "One row per service area", "source": "ReferenceSource"},
    "Owner": {"kind": "dimension", "grain": "One row per role based owner", "source": "ReferenceSource"},
    "Category": {"kind": "dimension", "grain": "One row per work category", "source": "ReferenceSource"},
    "Status": {"kind": "dimension", "grain": "One row per workflow status", "source": "ReferenceSource"},
    "Priority": {"kind": "dimension", "grain": "One row per priority", "source": "ReferenceSource"},
    "Model Settings": {"kind": "configuration", "grain": "One row of deterministic sample settings", "source": "Power Query parameters"},
    "Access Bridge": {"kind": "security_bridge", "grain": "One row per identity and service area grant", "source": "AccessSource"},
    "Measures": {"kind": "measure_table", "grain": "One hidden placeholder row", "source": "Inline Power Query table"}
  },
  "relationships": [
    {"from": "Operational Item.service_area_id", "to": "Service Area.service_area_id", "active": true},
    {"from": "Operational Item.owner_id", "to": "Owner.owner_id", "active": true},
    {"from": "Operational Item.category_id", "to": "Category.category_id", "active": true},
    {"from": "Operational Item.status", "to": "Status.status", "active": true},
    {"from": "Operational Item.priority", "to": "Priority.priority", "active": true},
    {"from": "Operational Item.target_key", "to": "Target.target_key", "active": true},
    {"from": "Operational Item.Opened Date", "to": "Date.Date", "active": true},
    {"from": "Operational Item.Due Date", "to": "Date.Date", "active": false},
    {"from": "Operational Item.Closed Date", "to": "Date.Date", "active": false},
    {"from": "Access Bridge.service_area_id", "to": "Service Area.service_area_id", "active": true, "security_filtering": "both_directions"}
  ],
  "measures": [
    "Total Items", "Open Items", "Paused Items", "Backlog Items", "Opened Items", "Closed Items", "Backlog As At", "Report Date", "Overdue Active Items", "Due Soon Items", "Average Cycle Time Days", "Closed Items With Valid SLA Inputs", "SLA Met Items", "SLA Met Rate", "SLA Target Rate", "SLA Variance To Target", "Target Matched Items", "Target Coverage Rate", "Missing Owner Count", "Missing Due Date Count", "Missing Target Count", "Closed Missing Evidence Count", "Data Readiness Issue Count", "Data Readiness Rate", "Review Flag Count", "High Priority Active Items", "High Priority Overdue Items", "Backlog As At Previous Month", "Month on Month Backlog Change", "Closed Items Previous Month", "Month on Month Closed Change"
  ],
  "report_pages": [
    {"name": "Executive Summary", "required_visual_types": ["textbox", "slicer", "cardVisual", "lineChart", "clusteredBarChart", "tableEx"]},
    {"name": "Assurance Detail", "required_visual_types": ["textbox", "cardVisual", "clusteredBarChart", "tableEx"]}
  ],
  "security_roles": ["Service Area Manager"]
}
